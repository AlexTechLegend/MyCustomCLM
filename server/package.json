{
  "name": "@vigil/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "rotate-key": "tsx src/cli.ts rotate-key",
    "backup": "tsx src/cli.ts backup",
    "restore": "tsx src/cli.ts restore",
    "bootstrap": "tsx src/cli.ts bootstrap"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
