# Copy to /etc/vigil/vigil.env (Linux) or next to the Windows service XML.
# Mode 0600. Never commit the real file.

NODE_ENV=production
VIGIL_AUTH=1
VIGIL_DATA_DIR=/var/lib/vigil
PORT=4180

# 64-char hex or a strong passphrase. First-run also writes data/secret.key (0600).
# VIGIL_SECRET_KEY=

# Optional overrides
# OPENSSL_BIN=/usr/bin/openssl
# VIGIL_INSTANCE_ID=vigil@prod-1
# VIGIL_LEADER_TTL_MS=30000
# VIGIL_SCHEDULER=1
# VIGIL_LOG_LEVEL=info
# VIGIL_TLS=1
